# AI CCTV Physical Display Monitoring Environment Configuration

# Database Configuration
# Primary: PostgreSQL (if provided and reachable)
# Fallback: SQLite (sqlite:///data/cctv_events.db)
# Option A: Full Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cctv_db

# Option B: Individual PostgreSQL Parameters
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=cctv_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Storage paths
EVENTS_STORAGE_PATH=data/events
KNOWN_PERSONS_STORAGE_PATH=data/known_persons.json

# Vision-Language Model (VLM) OpenAI-Compatible API Configuration
# Compatible with OpenAI (GPT-4o / GPT-4o-mini), Ollama, vLLM, LM Studio, OpenRouter, etc.
OPENAI_API_KEY=sk-proj-your-api-key-here
# VLM_API_KEY=sk-proj-your-api-key-here
# VLM_BASE_URL=https://api.openai.com/v1
# VLM_MODEL=gpt-4o-mini

